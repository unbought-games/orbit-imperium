{
  "name": "orbit-imperium",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "contracts": "openapi-typescript contracts/openapi.json -o apps/web/src/contracts.ts",
    "build": "npm run news:build && npm run routes && tsc --noEmit -p apps/web && node scripts/homepage-template.mjs && vite build --config apps/web/vite.config.ts",
    "test": "vitest run --config apps/web/vite.config.ts",
    "dev": "npm run news:build && vite --config apps/web/vite.config.ts",
    "test:e2e": "make test-core",
    "test:ui": "node scripts/ui-e2e.mjs",
    "lint": "eslint apps/web/src --max-warnings 0",
    "format:check": "prettier --check apps/web/src",
    "routes": "cd apps/web && tsr generate",
    "art:export": "node scripts/export-atlas-art.mjs",
    "news:build": "node scripts/news-history.mjs && node scripts/news.mjs",
    "release:suggest": "node scripts/prepare-release.mjs --suggest",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@floating-ui/react": "0.27.20",
    "@tanstack/react-router": "1.170.44",
    "@unbought/analytics": "file:vendor/unbought-analytics-0.1.1.tgz",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jotai": "3.0.1",
    "lucide-react": "1.57.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.56.1",
    "@tanstack/router-cli": "1.167.44",
    "@tanstack/router-plugin": "1.168.46",
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.37.0",
    "globals": "16.4.0",
    "js-yaml": "4.3.2",
    "markdown-it": "14.3.3",
    "openapi-typescript": "7.10.1",
    "pg": "8.16.3",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "version": "0.4.0"
}
