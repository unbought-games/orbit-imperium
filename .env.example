COMPOSE_PROJECT_NAME=orbit-imperium-dev
# Local development example; production secrets belong in the host secret store.
# For HTTPS set ORBIT_ORIGIN=https://game.example and omit the HTTP opt-in.
# ORBIT_LOCAL_INSECURE is retired: remove it, even if set to 0.
# DATABASE_URL=postgres://...
ORBIT_BIND=127.0.0.1:8080
ORBIT_ORIGIN=http://localhost:8080
# HTTP requires this explicit opt-in; HTTPS always uses Secure cookies.
ORBIT_ALLOW_INSECURE_HTTP=1
ORBIT_ASSETS=apps/web/dist
# ORBIT_SEED_PASSWORD_FILE=/private/path/to/two-line-password-file
ORBIT_LOGIN_PER_MINUTE=30

# Public player profiles (server-only; provision through Accounts):
# ORBIT_ACCOUNTS_PROFILE_CREDENTIAL=<profile-service credential>
# Defaults to the configured OIDC issuer without /api/auth:
# ORBIT_ACCOUNTS_API_URL=https://accounts.unbought.games

# Universe configuration is database-owned. Fresh setup: make dev-setup
# New worlds default to speed 5, topology 1 x 100 x 15, and open signup.
# With multiple universes, bind each API to an existing universe:
# ORBIT_UNIVERSE_ID=00000000-0000-4000-8000-000000000001
# See docs/operations/universe-configuration.md for creation and live policy edits.
