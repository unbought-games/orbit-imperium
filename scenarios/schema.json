{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orbit world scenario",
  "type": "object",
  "required": [
    "version",
    "edits"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "rules": {
      "type": "object"
    },
    "retained_rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "additionalProperties": false,
        "properties": {
          "user": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "preset": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "arrives_in": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "paid_rules_hash": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "minLength": 1
          },
          "planet": {
            "type": "string",
            "pattern": "^[1-9][0-9]*:[1-9][0-9]*:(?:[1-9]|1[0-5])$"
          },
          "all_planets": {
            "type": "boolean"
          },
          "returning": {
            "type": "boolean"
          },
          "vacation": {
            "type": "boolean"
          },
          "presence_age_ms": {
            "type": "integer",
            "minimum": 0
          },
          "ships": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "defenses": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "buildings": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "research": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "stock": {
            "type": "object",
            "required": [
              "metal",
              "crystal",
              "deuterium"
            ],
            "properties": {
              "metal": {
                "type": "integer",
                "minimum": 0
              },
              "crystal": {
                "type": "integer",
                "minimum": 0
              },
              "deuterium": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "paid": {
            "type": "object",
            "required": [
              "metal",
              "crystal",
              "deuterium"
            ],
            "properties": {
              "metal": {
                "type": "integer",
                "minimum": 0
              },
              "crystal": {
                "type": "integer",
                "minimum": 0
              },
              "deuterium": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "colony": {
            "type": "object",
            "required": [
              "fields",
              "max_temperature",
              "diameter_km"
            ],
            "properties": {
              "fields": {
                "type": "integer"
              },
              "max_temperature": {
                "type": "integer"
              },
              "diameter_km": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "payload": {
            "type": "object"
          },
          "valuation": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "category",
                "item",
                "level",
                "quantity",
                "unit_value_micro",
                "rules_hash"
              ],
              "properties": {
                "category": {
                  "type": "string"
                },
                "item": {
                  "type": "string"
                },
                "level": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit_value_micro": {
                  "type": "integer",
                  "minimum": 0
                },
                "rules_hash": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "first_in": {
            "type": "string"
          },
          "travel_time": {
            "type": "string"
          },
          "missiles": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "policy": {
      "type": "object"
    }
  }
}
