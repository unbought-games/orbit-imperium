{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbit fixed-view ship appearance package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "revision",
    "renderer",
    "target",
    "collection_id",
    "view",
    "channels",
    "map_encoding",
    "color_space",
    "alpha",
    "capabilities",
    "width",
    "height",
    "reference",
    "maps",
    "slots",
    "paint",
    "license",
    "attribution",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "view": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "const": 1
    },
    "renderer": {
      "const": "finish-decal-v1"
    },
    "channels": {
      "const": ["primary", "accent"]
    },
    "map_encoding": {
      "const": "rgba8-finish-decal-v1"
    },
    "color_space": {
      "const": "srgb"
    },
    "alpha": {
      "const": "straight-preserved"
    },
    "capabilities": {
      "const": {
        "treatments": ["none", "full", "layers"],
        "placements": ["near-wing", "paired"]
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["Ship", "Defense", "Building"]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
        }
      }
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "reference": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "pattern": "^#[a-fA-F0-9]{6}$"
      }
    },
    "maps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "material",
        "response",
        "receiver",
        "decalResponse"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "bytes"],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.png$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "bytes"],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.png$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "bytes"],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.png$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "receiver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "bytes"],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.png$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "decalResponse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "bytes"],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.png$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quad"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "quad": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 2048
              }
            }
          }
        }
      },
      "description": "Runtime validation additionally requires convex nondegenerate quads within native bounds and first slot near-wing."
    },
    "paint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opacity", "responseFloor", "responseCeiling"],
      "properties": {
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "responseFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "responseCeiling": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      },
      "description": "Runtime additionally requires floor <= ceiling."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "provenance": {
      "type": "object"
    }
  }
}
